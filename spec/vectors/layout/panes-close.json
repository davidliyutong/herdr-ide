{
  "description": "Closing terminals: the sibling takes the parent's place and, for the focused terminal, the focus; a tab without terminals goes, a workspace stays; pruning against the live terminals.",
  "input": {
    "version": 2,
    "workspaces": [
      {
        "id": "w",
        "name": "",
        "cwd": "/p",
        "tabs": [

    "selected": 0
  },
  "ops": [
    { "op": "closeTerminal", "terminal": "t1" },
    { "op": "openTerminal", "terminal": "t4" },
    { "op": "splitFocused", "axis": "horizontal", "terminal": "t5" },
    { "op": "closeTerminal", "terminal": "t4" },
    { "op": "prune", "live": ["t2", "t5", "t9"] },

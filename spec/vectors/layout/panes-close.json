              "split": "horizontal",
              "ratio": 0.5,
              "children": [
                { "terminal": "t1" },
                { "split": "vertical", "ratio": 0.9, "children": [{ "terminal": "t2" }, { "terminal": "t3" }] }
              ]
            },
            "focused": "t1"
          }
        ],
        "selected": 0
      },
      { "id": "w2", "name": "other", "cwd": "", "tabs": [{ "root": { "terminal": "t6" }, "focused": "t6" }], "selected": 0 }

{
  "name": "veldr-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "cycles": "node scripts/cycles.mjs",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" vite.config.ts"
  },
  "dependencies": {
    "@shikijs/langs": "4.6.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.78.0",
    "monaco-editor": "0.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.6.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tm-grammars": "1.32.22",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.8.1"
}

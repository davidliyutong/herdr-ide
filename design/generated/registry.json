{
  "agents": [
    {
      "id": "claude",
      "title": "Claude Code",
      "usageProvider": "claude",
      "start": [
        "claude"
      ],
      "newSession": [
        "--session-id",
        "{id}"
      ],
      "continueLatest": [
        "claude",
        "--continue"
      ],
      "resumeById": [
        "claude",
        "--resume",
        "{id}"
      ],
      "transcript": "claude",
      "chat": {
        "adapter": "claude"
      }
    },
    {
      "id": "codex",
      "title": "Codex",
      "usageProvider": "codex",
      "start": [
        "codex"
      ],
      "continueLatest": [
        "codex",
        "resume",
        "--last"
      ],
      "resumeById": [
        "codex",
        "resume",
        "{id}"
      ],
      "transcript": "codex",
      "chat": {
        "adapter": "codex"
      }
    },

        "space",
        "ctrl+a",
        "ctrl+c",
        "ctrl+d",
        "ctrl+k",
        "ctrl+r",
        "ctrl+w",
        "ctrl+z",
        "ctrl+space",
        "ctrl+backslash",
        "ctrl+bracketleft",
        "alt+b",
        "alt+f",
        "alt+period",
        "f1",
        "f10",
        "escape",
        "tab",
        "enter",
        "q",
        "ctrl+left"
      ],
      "results": [
        "none",
        "none",
        "none",
        "none",
        "none",
        "none",
        "none",
        "none",

{
  "description": "Key sequences as written in keybindings and their canonical form (modifiers cmd, ctrl, alt, shift; US-layout key names), or why they are refused. Run by internal/keybindings, web/src/__tests__/keys.test.ts and macos/Tests/TermKitTests.",
  "cases": [
    { "input": "ctrl+b c", "key": "ctrl+b c" },
    { "input": "Ctrl+B  C", "key": "ctrl+b c" },
    { "input": "shift+cmd+T", "key": "cmd+shift+t" },
    { "input": "alt+shift+ctrl+cmd+k", "key": "cmd+ctrl+alt+shift+k" },
    { "input": "command+option+control+x", "key": "cmd+ctrl+alt+x" },
    { "input": "meta+k", "key": "cmd+k" },
    { "input": "super+k", "key": "cmd+k" },
    { "input": "opt+left", "key": "alt+left" },
    { "input": "ctrl+b ?", "key": "ctrl+b shift+slash" },
    { "input": "ctrl+b shift+?", "key": "ctrl+b shift+slash" },
    { "input": "cmd+}", "key": "cmd+shift+bracketright" },
    { "input": "cmd+{", "key": "cmd+shift+bracketleft" },
    { "input": "ctrl+,", "key": "ctrl+comma" },
    { "input": "cmd+comma", "key": "cmd+comma" },
    { "input": "ctrl+b -", "key": "ctrl+b minus" },
    { "input": "ctrl+b |", "key": "ctrl+b shift+backslash" },
    { "input": "ctrl+b !", "key": "ctrl+b shift+1" },
    { "input": "ctrl++", "key": "ctrl+shift+equal" },
    { "input": "ctrl+plus", "key": "ctrl+shift+equal" },
    { "input": "ctrl+=", "key": "ctrl+equal" },
    { "input": "ctrl+b esc", "key": "ctrl+b escape" },
    { "input": "ctrl+b return", "key": "ctrl+b enter" },
    { "input": "ctrl+b arrowleft", "key": "ctrl+b left" },
    { "input": "ctrl+b pgdn", "key": "ctrl+b pagedown" },
    { "input": "ctrl+b shift+tab", "key": "ctrl+b shift+tab" },
    { "input": "ctrl+b space", "key": "ctrl+b space" },
    { "input": "ctrl+b 1", "key": "ctrl+b 1" },
    { "input": "f5", "key": "f5" },
    { "input": "shift+F12", "key": "shift+f12" },
    { "input": "ctrl+k ctrl+s", "key": "ctrl+k ctrl+s" },
    { "input": "ctrl+[", "key": "ctrl+bracketleft" },
    { "input": "ctrl+`", "key": "ctrl+backtick" },
    { "input": "ctrl+'", "key": "ctrl+quote" },
    { "input": "alt+;", "key": "alt+semicolon" },
    { "input": "cmd+.", "key": "cmd+period" },
    { "input": "cmd+/", "key": "cmd+slash" },
    { "input": "ctrl+\\", "key": "ctrl+backslash" },
    { "input": "", "error": "empty" },
    { "input": "   ", "error": "empty" },
    { "input": "ctrl+", "error": "empty" },
    { "input": "c", "error": "typing" },
    { "input": "shift+a", "error": "typing" },
    { "input": "shift+tab", "error": "typing" },
    { "input": "space ctrl+b", "error": "typing" },
    { "input": "hyper+k", "error": "modifier" },
    { "input": "ctrl+ctrl+k", "error": "repeat" },
    { "input": "cmd+meta+k", "error": "repeat" },
    { "input": "ctrl+f25", "error": "key" },
    { "input": "ctrl+é", "error": "key" },
    { "input": "ctrl+ab", "error": "key" },
    { "input": "ctrl+a b c d e", "error": "length" }
  ]
}

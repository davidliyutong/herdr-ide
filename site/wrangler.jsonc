{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "veldr-site",
  "account_id": "6dcf4c92a4c4d0252663ce501ad5dcf3",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "veldr.app", "custom_domain": true },
    { "pattern": "www.veldr.app", "custom_domain": true },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/cli/*"],
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sh"],
      "fallthrough": true,
    },
  ],
  "vars": {
    "GITHUB_REPO": "davidliyutong/veldr",
  },
}

{
  "name": "desktop-shell",
  "private": true,
  "version": "0.1.0",
  "description": "Native desktop launcher for the terminal IDE",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node test.mjs",
    "format": "prettier --write src build.mjs test.mjs electron-builder.cjs",
    "format:check": "prettier --check src build.mjs test.mjs electron-builder.cjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.8.1"
}

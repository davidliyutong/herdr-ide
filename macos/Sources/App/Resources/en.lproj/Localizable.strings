"settings.code-server-install" = "Installation";
"settings.code-server-install.desc" = "Upload: the server downloads, verifies and uploads it (works for offline machines). Machine downloads: each machine fetches it itself, verified against the same checksum. Use installed: run the code-server already on the machine. The last two fall back to uploading. Applies the next time code-server starts on a machine.";
"settings.code-server-install.push" = "Upload";
"settings.code-server-install.download" = "Machine downloads";
"settings.code-server-install.existing" = "Use installed";
"settings.code-server-path" = "Installed code-server";
"settings.code-server-path.desc" = "For “Use installed”: path on the machines (absolute or ~/). Empty searches PATH, ~/.local/bin, /opt/homebrew/bin, /usr/local/bin, /usr/bin and /snap/bin.";
"settings.code-server-path.placeholder" = "Search automatically";
"settings.gui" = "Show program windows";
"settings.gui.desc" = "Windows of programs on remote Linux machines (matplotlib, MuJoCo, …) open in browser windows. New panes get a virtual display; Xvfb is fetched without privileges when the machine lacks it. Applies to panes created afterwards.";
"settings.gui.on" = "On";
"settings.gui.off" = "Off";
"settings.gui-gpu" = "GPU rendering (VirtualGL)";
"settings.gui-gpu.desc" = "On machines with VirtualGL. With vglrun: programs started as “vglrun program” render on the GPU. All programs: every program in new panes runs under VirtualGL.";
"settings.gui-gpu.vglrun" = "With vglrun";
"settings.gui-gpu.all" = "All programs";
"settings.gui-video" = "Video for moving windows";
"settings.gui-video.desc" = "Windows that keep changing (a simulator, a rotating plot) are sent as video: H.264 on machines with an NVIDIA, Intel or AMD GPU, else VP8 on the CPU. Needs a browser with WebCodecs on localhost or HTTPS. Still windows are always sent as exact pictures; when video is not possible, pictures are used.";
"settings.gui-video.on" = "On";
"settings.gui-video.off" = "Off";
"settings.desktop-new-tab-key" = "New tab";
"settings.desktop-new-tab-key.desc" = "Works wherever focus is, also in VS Code. The prefix binding keeps working.";
"settings.desktop-close-tab-key" = "Close tab";
"settings.desktop-close-tab-key.desc" = "Replaces closing the window with this key. Remove the shortcut to give the key back to the window.";
"settings.desktop-settings-key" = "Open settings";
"settings.desktop-settings-key.desc" = "Also in the app menu. In VS Code the key opens VS Code’s settings.";
"settings.desktop-new-workspace-key" = "New workspace";
"settings.desktop-new-workspace-key.desc" = "Asks for the folder of the new workspace. In VS Code the key stays VS Code’s (new file).";
"settings.desktop-toggle-code-key" = "Show or hide VS Code";
"settings.desktop-toggle-code-key.desc" = "Hides the VS Code or preview panel, or shows the VS Code panel again (else opens the pane’s folder). Also works while VS Code has focus, which then loses this key.";

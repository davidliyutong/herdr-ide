"settings.codeServer.install.desc" = "Upload: the server downloads, verifies and uploads it (works for offline machines). Machine downloads: each machine fetches it itself, verified against the same checksum. Use installed: run the code-server already on the machine. The last two fall back to uploading. Applies the next time code-server starts on a machine.";
"settings.codeServer.path.desc" = "For “Use installed”: path on the machines (absolute or ~/). Empty searches PATH, ~/.local/bin, /opt/homebrew/bin, /usr/local/bin, /usr/bin and /snap/bin.";
"settings.codeServer.path.placeholder" = "Search automatically";
"settings.gui.enabled.desc" = "Windows of programs on remote Linux machines (matplotlib, MuJoCo, …) open in windows of their own. New terminals get a virtual display; Xvfb is fetched without privileges when the machine lacks it. Applies to terminals created afterwards.";
"settings.gui.gpu.desc" = "On machines with VirtualGL. With vglrun: programs started as “vglrun program” render on the GPU. All programs: every program in new panes runs under VirtualGL.";
"settings.gui.video.desc" = "Windows that keep changing (a simulator, a rotating plot) are sent as video: H.264 on machines with an NVIDIA, Intel or AMD GPU, else VP8 on the CPU. Needs a browser with WebCodecs on localhost or HTTPS. Still windows are always sent as exact pictures; when video is not possible, pictures are used.";
"settings.terminal.bell.desc" = "What the terminal bell (BEL) does.";
"settings.terminal.boldIsBright.desc" = "Bold text in one of the first 8 colors uses its bright variant.";
"settings.terminal.colors.dark.palette.desc" = "Black, red, green, yellow, blue, magenta, cyan and white, then their bright variants: the colors programs pick by number. 24-bit colors are not affected.";
"settings.terminal.colors.light.palette.desc" = "Black, red, green, yellow, blue, magenta, cyan and white, then their bright variants: the colors programs pick by number. 24-bit colors are not affected.";
"settings.terminal.copyOnSelect.desc" = "Selected text goes to the clipboard at once.";

{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "description": "The core and the machine agent, in TypeScript: Node APIs for what also runs in the desktop app, Bun for the machines and the command line",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.bun.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry": "bun scripts/registry.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.8.1",
  "imports": {
    "#shared/*": "./shared/*",
    "#kernel/*": "./kernel/*",
    "#machine/*": "./machine/*",
    "#features/*": "./features/*",
    "#hosts/*": "./hosts/*"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0",
    "execa": "10.2.1",
    "hono": "4.13.21",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.1.0",
    "ssh-config": "5.3.1",
    "ws": "8.23.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  }
}
